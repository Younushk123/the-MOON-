{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AnalysisResultItem": {
      "additionalProperties": false,
      "properties": {
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "variable": {
          "title": "Variable",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "metric",
        "variable",
        "value"
      ],
      "title": "AnalysisResultItem",
      "type": "object"
    },
    "DataQuality": {
      "additionalProperties": false,
      "properties": {
        "missing_values": {
          "minimum": 0,
          "title": "Missing Values",
          "type": "integer"
        },
        "validation_passed": {
          "title": "Validation Passed",
          "type": "boolean"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "missing_values",
        "validation_passed"
      ],
      "title": "DataQuality",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analysis_id": {
      "title": "Analysis Id",
      "type": "string"
    },
    "experiment_id": {
      "title": "Experiment Id",
      "type": "string"
    },
    "analysis_type": {
      "const": "statistical_summary",
      "title": "Analysis Type",
      "type": "string"
    },
    "status": {
      "enum": [
        "success",
        "partial",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/AnalysisResultItem"
      },
      "title": "Results",
      "type": "array"
    },
    "data_quality": {
      "$ref": "#/$defs/DataQuality"
    },
    "source_ids": {
      "items": {
        "type": "string"
      },
      "title": "Source Ids",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "analysis_id",
    "experiment_id",
    "analysis_type",
    "status",
    "data_quality"
  ],
  "title": "AnalysisResult",
  "type": "object"
}
