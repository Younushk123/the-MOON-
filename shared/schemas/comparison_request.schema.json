{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "experiment_ids": {
      "items": {
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 10,
      "minItems": 2,
      "title": "Experiment Ids",
      "type": "array"
    },
    "variables": {
      "anyOf": [
        {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Defaults to every variable measured in any of the experiments.",
      "title": "Variables"
    }
  },
  "required": [
    "experiment_ids"
  ],
  "title": "ComparisonRequest",
  "type": "object"
}
