  "additionalProperties": false,
  "properties": {
    "question": {
      "maxLength": 1000,
      "minLength": 3,
      "title": "Question",
      "type": "string"
    },
    "experiment_ids": {
      "items": {
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 10,
      "title": "Experiment Ids",
