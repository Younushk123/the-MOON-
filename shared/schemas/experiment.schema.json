{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "experiment_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Experiment Id",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "investigation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Investigation"
    },
    "program": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Program"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "platform": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Platform"
    },
    "source_ids": {
      "items": {
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
      },
      "title": "Source Ids",
      "type": "array"
    },
    "data_status": {
      "default": "unverified",
      "enum": [
        "illustrative",
        "unverified",
        "metadata_verified",
        "content_verified"
      ],
      "title": "Data Status",
      "type": "string"
    },
    "available_measurements": {
      "description": "Variables that have at least one measurement record.",
      "items": {
        "maxLength": 100,
        "minLength": 1,
        "type": "string"
      },
      "title": "Available Measurements",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "last_updated": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Updated"
    }
  },
  "required": [
    "experiment_id",
    "name"
  ],
  "title": "Experiment",
  "type": "object"
}
