{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "experiment_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Experiment Id",
      "type": "string"
    },
    "analysis_type": {
      "const": "statistical_summary",
      "default": "statistical_summary",
      "title": "Analysis Type",
      "type": "string"
    },
    "variables": {
      "anyOf": [
        {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Defaults to all of the experiment's measured variables.",
      "title": "Variables"
    }
  },
  "required": [
    "experiment_id"
  ],
  "title": "AnalysisRequest",
  "type": "object"
}
