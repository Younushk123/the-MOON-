{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "experiment_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Experiment Id"
        },
        "evidence_text": {
          "minLength": 1,
          "title": "Evidence Text",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "pattern": "^https?://\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "source_id",
        "evidence_text"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "insight_id": {
      "title": "Insight Id",
      "type": "string"
    },
    "question": {
      "title": "Question",
      "type": "string"
    },
    "claim": {
      "title": "Claim",
      "type": "string"
    },
    "supporting_evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Supporting Evidence",
      "type": "array"
    },
    "fire_safety_relevance": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fire Safety Relevance"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "confidence": {
      "default": "not_assessed",
      "enum": [
        "not_assessed",
        "low",
        "medium",
        "high"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "evidence_status": {
      "enum": [
        "supported",
        "partially_supported",
        "insufficient_evidence"
      ],
      "title": "Evidence Status",
      "type": "string"
    }
  },
  "required": [
    "insight_id",
    "question",
    "claim",
    "evidence_status"
  ],
  "title": "Insight",
  "type": "object"
}
