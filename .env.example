# ==============================================================================
# NASA Microgravity Combustion RAG - Environment Configuration Example
# Copy this file to .env and set your secrets / local configuration
# Command: copy .env.example .env (Windows) or cp .env.example .env (Linux/Mac)
# ==============================================================================

# Groq API Key (Optional: System operates in extractive offline mode if unset)
GROQ_API_KEY=gsk_your_groq_api_key_here

# THE MOON FastAPI deployment
MOON_DATA_MODE=psi
MOON_CORS_ORIGINS=["http://localhost:5173","https://your-frontend.vercel.app"]
MOON_RAG_MODE=extractive

# Groq Model (Default: llama-3.1-8b-instant)
GROQ_MODEL=llama-3.1-8b-instant

# Embedding Model (HuggingFace / Sentence Transformers)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ChromaDB Vector Store Persistence Directory
CHROMA_PERSIST_DIR=data/processed/chroma

# FastAPI Service Host & Port
API_HOST=0.0.0.0
API_PORT=8000
